image input = load("/workspace/dsl-image-processing/build/panda_with_heart.jpg");

input.save("/workspace/dsl-image-processing/build/output.jpg");

num i1 = input[0][1][0];
num i2;
num i3 = 5.3;

input[0][1][1] = 5;

input[0][5][2] = i1 + i2 * i3;

apply_threshold(input, 100.3, 50.999);

apply_boxblur(input, 3);

adjust_brightness(input , 100);

adjust_contrast(input , 100);